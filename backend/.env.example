# SmartCity AirGuard AI - Environment Configuration
PROJECT_NAME="SmartCity AirGuard AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# API and CORS
API_V1_STR="/api"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL="sqlite:///./airguard.db"

# Data directories
DATASETS_DIR="../datasets"
MODELS_DIR="./saved_models"

# External Data APIs (Optional - Fallbacks to local sample data if not configured)
OPENAQ_API_KEY=""
WEATHER_API_KEY=""
