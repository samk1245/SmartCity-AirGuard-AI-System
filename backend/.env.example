# SmartCity AirGuard AI 2.0 — Environment Configuration
# Duplicate this file to .env and configure your local or production settings.
# Sensitive keys must NEVER be committed into public repositories.

ENVIRONMENT=development
DEBUG=true

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./airguard.db

# API Keys (Optional: Core functionality operates smoothly with zero keys via Open-Meteo & Nominatim)
OPENAQ_API_KEY=
WEATHER_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
